#
# Applies iptables rules to drop ICMP timestamp requests and replies,
# mitigating CVE-1999-0524. The Linux kernel has no sysctl to suppress
# ICMP timestamp responses; netfilter is the supported mitigation per
# upstream netdev maintainers. This script is invoked by
# delphix-icmp-filter.service on every boot.
#
# Each rule is applied idempotently: -C checks for the rule first; -A
# appends it only when absent. set -euo pipefail ensures the service
# fails visibly if iptables is unavailable.
#

set -euo pipefail

iptables -C INPUT -p icmp --icmp-type timestamp-request -j DROP 2>/dev/null ||
	iptables -A INPUT -p icmp --icmp-type timestamp-request -j DROP
iptables -C OUTPUT -p icmp --icmp-type timestamp-reply -j DROP 2>/dev/null ||
	iptables -A OUTPUT -p icmp --icmp-type timestamp-reply -j DROP
