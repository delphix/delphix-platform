#
# Applies the static nftables ruleset in /etc/nftables.d/delphix.nft at
# boot, and reverses it on stop. Named generically (not after the specific
# filtering mechanism) so a future rule addition is an edit to that
# ruleset file, not a new service. It is wanted by and ordered before
# network-pre.target so rules are in place before any network interfaces
# are configured.
#
# The first consumer is the ICMP timestamp filter mitigating CVE-1999-0524:
# see /etc/nftables.d/delphix.nft for details.
#
# DefaultDependencies=no is required: any unit ordered Before=network-pre.target
# otherwise implicitly gets After=sysinit.target, which forms an ordering cycle
# with network-pre.target (sysinit.target depends on units that themselves come
# after network-pre.target, e.g. cloud-init.service). systemd breaks such a cycle
# by dropping one of the jobs arbitrarily, which was silently deleting
# cloud-init.service's start job every boot and skipping first-boot network/SSH
# setup entirely.
#
# DefaultDependencies=no also drops the implicit After=local-fs.target, so this
# must be added back explicitly: without it, this unit could run before /usr is
# mounted on a system with a separate /usr, and /usr/sbin/nft wouldn't exist
# yet. Same pattern as delphix-sb-enroll.service.
#
# ExecStop deletes the table this unit's own ExecStart created, so
# RemainAfterExit=yes's "active" state actually corresponds to the rules
# being in effect: without it, stopping this unit (e.g. prerm's
# "disable --now" on removal/upgrade) would leave the table's rules live
# in the kernel with nothing to reverse them.
#

[Unit]
Description=Delphix boot-time nftables firewall rules
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
ConditionVirtualization=!container

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/nftables.d/delphix.nft
ExecStop=/usr/sbin/nft delete table inet delphix
RemainAfterExit=yes
TimeoutSec=30

[Install]
WantedBy=network-pre.target
